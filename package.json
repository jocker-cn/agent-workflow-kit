{
  "name": "agent-workflow-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Prompt-driven, browser-assisted workflow foundation for coding agents.",
  "type": "module",
  "scripts": {
    "workflow": "node ./src/workflowctl.mjs",
    "check": "node ./src/workflowctl.mjs help",
    "test": "node --test",
    "browser": "playwright-cli",
    "browser:help": "playwright-cli --help",
    "browser:install": "playwright-cli install",
    "browser:install-browser": "playwright-cli install-browser chromium",
    "browser:fill-secret": "node ./src/browser/fill-secret.mjs",
    "browser:wait": "node ./src/browser/wait-for-snapshot.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.30.3",
  "devDependencies": {
    "@playwright/cli": "^0.1.17"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  }
}
